# 森林氧吧后端环境变量（复制为 .env 后按需修改；不配置则使用下方默认值）

# 服务端口
PORT=3001

# JWT 签名密钥（务必更换为强随机值，例：openssl rand -hex 24）
JWT_SECRET=<替换为你的强随机密钥>

# token 有效期（毫秒，默认 8 小时）
JWT_EXPIRES_MS=28800000

# 预约可开放的天数窗口（今/明/后天 => 3）
BOOKING_WINDOW_DAYS=3

# 登录连续失败锁定阈值 / 锁定分钟数
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# bcrypt 加密强度
BCRYPT_ROUNDS=10

# 初始管理员账号（用于首次启动引导；密码为 8 位数字，请改为自己的）
ADMIN_PHONE=13800000001
ADMIN_PASSWORD=<改为你自己的 8 位密码>
ADMIN_NAME=系统管理员

# ---- 存储引擎 ----
# mysql：使用 MySQL 库 forest_oxygen（生产/联调推荐，见 server/sql/schema-mysql.sql）
# file ：使用 JSON 文件（兼容旧数据，自检 selfcheck 使用）
STORE=mysql

# MySQL 连接（STORE=mysql 时生效；建议使用仅授 DML 的应用账号，勿用 root）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=forest_app
DB_PASSWORD=请改成你的应用账号密码
DB_NAME=forest_oxygen

# 文件存储位置（STORE=file 时生效）
DATA_FILE=./data/store.json

# 环境数据模拟刷新间隔（毫秒）
ENV_REFRESH_MS=6000
